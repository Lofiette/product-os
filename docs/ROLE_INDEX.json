      "default": [
        "product-planning"
      ],
      "optional": [
        "creative-improvement-loop",
        "experiment-design",
        "market-research-planning"
      ],
      "handoffs": [
        "business_analyst",
        "product_designer",
        "delivery_manager"
      ],
      "triggers": [
        "new product/feature",
        "unclear user value",
        "MVP/prototype scope needed",
        "prioritization needed"
      ]
    },
