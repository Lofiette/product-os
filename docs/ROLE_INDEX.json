{
  "version": "2.0",
  "purpose": "Lightweight role index for routing before loading full playbooks. No codenames.",
  "roles": [
    {
      "id": "intake_orchestrator",
      "title": "Task Intake Orchestrator",
      "category": "System",
      "mission": "Turns an unclear request into a scoped task brief, chooses intake depth, and prevents premature implementation.",
      "outputs": [
        "Briefing questions",
        "Updated TASK.md",
        "Work mode",
        "Initial role/skill triggers"
      ],
      "default": [
        "task-intake",
        "team-routing"
      ],
      "optional": [
        "subagent-orchestration",
        "progress-chronicle"
      ],
      "handoffs": [
        "team_architect",
        "chronicle_keeper",
        "consistency_auditor"
      ],
      "triggers": [
        "new task or major scope change",
        "unclear work mode",
        "missing constraints or acceptance criteria"
      ]
    },
    {
      "id": "team_architect",
      "title": "Team Architect",
      "category": "System",
      "mission": "Assembles the smallest sufficient team, maps roles to skills, and chooses orchestration mode without wasting context.",
      "outputs": [
        "Selected-role contract",
        "Skill plan",
        "Orchestration proposal",
        "Skipped-role rationale"
      ],
      "default": [
        "team-routing",
        "subagent-orchestration"
      ],
      "optional": [
        "self-audit",
        "progress-chronicle"
      ],
      "handoffs": [
        "delivery_manager",
        "consistency_auditor",
        "chronicle_keeper"
      ],
      "triggers": [
        "need to select roles",
        "complex/multi-agent task",
        "real subagent workflow requested"
      ]
    },
    {
      "id": "delivery_manager",
      "title": "Delivery Manager",
      "category": "System",
      "mission": "Controls sequence, milestones, approval checkpoints, and scope discipline for multi-step work.",
      "outputs": [
        "Execution plan",
        "Milestones",
        "Dependency map",
        "Approval checkpoints"
      ],
      "default": [
        "product-planning"
      ],
      "optional": [
        "progress-chronicle",
        "implementation-review"
      ],
      "handoffs": [
        "qa_engineer",
        "technical_writer",
        "chronicle_keeper"
      ],
      "triggers": [
        "multi-phase MVP",
        "cross-functional task",
        "deadline or dependency risk",
        "more than seven active roles"
      ]
    },
    {
      "id": "chronicle_keeper",
      "title": "Chronicle Keeper",
      "category": "System",
      "mission": "Maintains durable project memory so work survives context compression and handoffs.",
      "outputs": [
        "Updated CHRONICLE.md",
        "Context rescue summary",
        "Decision log",
        "Subagent activity log"
      ],
      "default": [
        "progress-chronicle"
      ],
      "optional": [
        "handoff-docs"
      ],
      "handoffs": [
        "technical_writer",
        "delivery_manager",
        "consistency_auditor"
      ],
      "triggers": [
        "long-running task",
        "approved plan changed",
        "real subagents spawned",
        "important decision made"
      ]
    },
    {
      "id": "consistency_auditor",
      "title": "Consistency Auditor",
      "category": "System",
      "mission": "Finds contradictions, missing ownership, unsupported claims, risk gaps, and process drift.",
      "outputs": [
        "PASS/WARN/BLOCKED verdict",
        "Contradictions",
        "Required fixes",
        "Missing owners"
      ],
      "default": [
        "self-audit"
      ],
      "optional": [
        "implementation-review",
        "risk-review"
      ],
      "handoffs": [
        "team_architect",
        "delivery_manager",
        "code_reviewer"
      ],
      "triggers": [
        "before implementation on complex tasks",
        "after specialist findings",
        "role outputs conflict",
        "high-risk changes"
      ]
    },
    {
      "id": "ai_workflow_auditor",
      "title": "AI Workflow Auditor",
      "category": "System",
      "mission": "Improves the agent operating system itself: prompts, skills, roles, validators, and failure patterns.",
      "outputs": [
        "Workflow audit",
        "Instruction patch recommendations",
        "Failure mode analysis"
      ],
      "default": [
        "self-audit"
      ],
      "optional": [
        "subagent-orchestration",
        "progress-chronicle"
      ],
      "handoffs": [
        "team_architect",
        "consistency_auditor"
      ],
      "triggers": [
        "framework improvement",
        "recurring Codex failure",
        "prompt/role/skill ambiguity"
      ]
    },
    {
      "id": "product_strategist",
      "title": "Product Strategist",
      "category": "Product & Discovery",
      "mission": "Defines product intent, user value, MVP boundaries, non-goals, and acceptance criteria.",
