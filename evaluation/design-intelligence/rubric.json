      "minimum_weighted_mean": 3.0,
      "minimum_each_applicable": 2,
      "allow_blockers": false,
      "requires_rendered_evidence_for_visual_claims": true
    },
    "PASS_WITH_WARNINGS": {
      "minimum_weighted_mean": 2.5,
      "minimum_each_applicable": 2,
      "allow_blockers": false
    },
    "BLOCKED": {
      "trigger": "any blocker or critical dimension scored 0-1"
    },
    "INSUFFICIENT_EVIDENCE": {
      "trigger": "required evidence unavailable"
    }
