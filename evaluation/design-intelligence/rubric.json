  "blocking_conditions": [
    "solution misses the stated problem or invents critical facts",
    "primary task, action, consequence, location, or current state is materially ambiguous",
    "material state or recovery path is missing",
    "interaction and visual hierarchy contradict each other",
    "critical accessibility issue",
    "unapproved design-system violation",
    "misleading or unrecoverably truncated data",
    "implementation must invent core behavior",
    "high-risk or destructive action lacks sufficient consequence or recovery design"
