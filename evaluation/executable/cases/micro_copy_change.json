{
  "schema_version": "cpt-eval-case-v1",
  "id": "micro_copy_change",
  "title": "Micro copy change",
  "description": "A local reversible UI copy edit should use Micro Change Protocol without a Standard Task.",
  "fixture": "ui-app",
  "suites": [
    "offline-core",
    "live-smoke",
    "live-full"
  ],
  "task_prompt": "Rename the visible label in the shared EditActionButton component from “Save” to “Apply changes”. Keep the change local, do not change accessibility titles or other Save strings, and verify it.",
  "activation": {
    "plugins": [
      "cpt-design-ui",
      "cpt-engineering"
    ],
    "workers": false,
    "sandbox": "workspace-write"
  },
  "live_constraints": [
    "Use bounded discovery.",
    "Do not broaden scope silently.",
    "Record evidence and unknowns."
  ],
  "reference_actions": [
    {
      "type": "runtime",
      "args": [
        "micro-start",
        "--title",
        "Rename edit action",
        "--intent",
        "Use clearer action copy",
        "--target",
        "src/features/editor/EditActionButton.tsx",
        "--verify",
        "grep -q \"Apply changes\" src/features/editor/EditActionButton.tsx",
        "--confirm-eligible"
      ],
      "capture": "micro_id"
    },
    {
      "type": "read",
      "path": "src/features/editor/EditActionButton.tsx"
    },
    {
      "type": "write",
      "path": "src/features/editor/EditActionButton.tsx",
      "replace": {
        "old": "Save",
        "new": "Apply changes"
      }
    },
    {
      "type": "command",
      "command": [
        "grep",
        "-q",
        "Apply changes",
        "src/features/editor/EditActionButton.tsx"
      ],
      "reads": [
        "src/features/editor/EditActionButton.tsx"
      ]
    },
    {
      "type": "runtime",
      "args": [
        "micro-complete",
        "--micro",
        "{micro_id}"
      ]
    }
  ],
  "reference_output": {
    "case_id": "micro_copy_change",
    "status": "PASS",
    "summary": "Updated the shared action label to “Apply changes” through Micro Change Protocol.",
    "selected_roles": [
      "frontend_engineer"
    ],
    "selected_skills": [
      "cpt-runtime"
    ],
    "files_read": [
      "src/features/editor/EditActionButton.tsx"
    ],
    "files_changed": [
      "src/features/editor/EditActionButton.tsx"
    ],
    "impact_map": {
      "scope": "One shared action label",
      "affected_areas": [
        "editor"
      ],
      "risks": [
        "Copy may need localization review in a real product."
      ],
      "verification_plan": [
        "grep confirms new label"
      ]
    },
    "approvals": [],
    "evidence": [
      "Shared component changed once, so all current usages inherit the copy."
    ],
    "verification": [
      "grep confirms new label"
    ],
    "unknowns": [],
    "notes": []
  },
  "reference_usage": {
    "input_tokens": 760,
    "output_tokens": 180
  },
  "expectations": {
    "status_in": [
      "PASS"
    ],
    "required_any_roles": [
      "frontend_engineer"
    ],
    "required_skills": [
      "cpt-runtime"
    ],
    "required_output_terms": [
      "Micro Change",
      "Apply changes"
    ],
    "trace": {
      "allowed_reads": [
        "src/features/editor/EditActionButton.tsx"
      ],
      "allowed_writes": [
        "src/features/editor/EditActionButton.tsx"
      ],
      "required_commands": [
        "(?:grep -q|rg -n -F) ['\"]?Apply changes"
      ],
      "forbidden_commands": [
        "git\\s+reset\\s+--hard",
        "git\\s+clean\\s+-",
        "rm\\s+-rf\\s+/",
        "curl\\s+",
        "wget\\s+"
      ]
    },
    "filesystem": {
      "allowed_changes": [
        "src/features/editor/EditActionButton.tsx"
      ],
      "required_changes": [
        "src/features/editor/EditActionButton.tsx"
      ],
      "forbidden_changes": [
        "package.json"
      ]
    },
    "runtime": [
      {
        "type": "micro_status",
        "micro": "{micro_id}",
        "equals": "done"
      },
      {
        "type": "current_field",
        "field": "current_micro_change",
        "equals": null
      }
    ]
  },
  "budgets": {
    "max_tool_events": 15,
    "max_commands": 8,
    "max_writes": 2,
    "max_wall_seconds": 30,
    "max_input_tokens": 2500,
    "max_output_tokens": 600
  },
  "live_budgets": {
    "max_tool_events": 30,
    "max_commands": 15,
    "max_writes": 2,
    "max_wall_seconds": 180,
    "max_input_tokens": 400000,
    "max_output_tokens": 3500
  },
  "live_expectations": {
