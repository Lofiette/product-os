        "src/features/editor/EditActionButton.tsx",
        "src/features/editor/AccessibleForm.tsx",
        "scripts/check_ui.py",
        "package.json"
      ],
      "required_commands": [
        "python \\.cpt/bin/cpt_runtime\\.py validate"
      ]
    }
  }
}
