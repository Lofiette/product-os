{
  "schema_version": "cpt-eval-case-v1",
  "id": "systemic_edit_mode_change",
  "title": "Systemic edit-mode change",
  "description": "A task must identify a shared component instead of patching one screen.",
  "fixture": "ui-app",
  "suites": [
    "offline-core",
    "live-full"
  ],
  "task_prompt": "Change the edit-mode primary action systemically across toolbar, panel, and dialog. Produce an Impact Map before editing.",
  "activation": {
    "plugins": [
      "cpt-design-ui",
      "cpt-engineering"
    ],
    "workers": false,
    "sandbox": "workspace-write"
  },
  "live_constraints": [
    "Use bounded discovery.",
    "Do not broaden scope silently.",
    "Record evidence and unknowns."
  ],
  "reference_actions": [
    {
      "type": "runtime",
      "args": [
        "create-task",
        "--title",
        "Systemic edit action",
        "--objective",
        "Update edit action through the shared component",
        "--task-type",
        "ui_implementation",
        "--complexity",
        "standard",
        "--activate"
      ],
      "capture": "task_id"
    },
    {
      "type": "approval",
      "scope": "bounded discovery"
    },
    {
      "type": "read",
      "path": "src/features/editor/EditToolbar.tsx"
    },
    {
      "type": "read",
      "path": "src/features/editor/EditPanel.tsx"
    },
    {
      "type": "read",
      "path": "src/features/editor/EditDialog.tsx"
    },
    {
      "type": "read",
      "path": "src/features/editor/EditActionButton.tsx"
    },
    {
      "type": "runtime",
      "args": [
        "lease-create",
        "--task",
        "{task_id}",
        "--read",
        "src/features/editor/**",
        "--write",
        "src/features/editor/EditActionButton.tsx",
        "--verify",
        "grep -q \"Apply changes\" src/features/editor/EditActionButton.tsx",
        "--rationale",
        "Approved systemic edit-mode change"
      ],
      "capture": "lease_id"
    },
    {
      "type": "approval",
      "scope": "implementation lease"
    },
    {
      "type": "write",
      "path": "src/features/editor/EditActionButton.tsx",
      "replace": {
        "old": "Save",
        "new": "Apply changes"
      }
    },
    {
      "type": "command",
      "command": [
        "grep",
        "-q",
        "Apply changes",
        "src/features/editor/EditActionButton.tsx"
      ],
      "reads": [
        "src/features/editor/EditActionButton.tsx"
      ]
    },
    {
      "type": "runtime",
      "args": [
        "knowledge-task-assess",
        "--task",
        "{task_id}",
        "--status",
        "not_required",
        "--summary",
        "Copy change does not alter durable product structure"
      ]
    },
    {
      "type": "runtime",
      "args": [
        "complete-task",
        "--task",
        "{task_id}"
      ]
    }
  ],
  "reference_output": {
    "case_id": "systemic_edit_mode_change",
