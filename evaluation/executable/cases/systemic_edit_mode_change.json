      "src/features/editor/EditPanel.tsx",
      "src/features/editor/EditDialog.tsx",
      "src/features/editor/EditActionButton.tsx"
    ],
    "files_changed": [
      "src/features/editor/EditActionButton.tsx"
    ],
    "impact_map": {
      "scope": "Shared edit action used by three surfaces",
      "affected_areas": [
        "editor",
