      "product_designer"
    ],
    "required_skills": [
      "cpt-task-planning",
      "cpt-frontend-integration"
    ],
    "required_output_terms": [
      "shared",
      "toolbar",
      "panel",
      "dialog"
    ],
    "trace": {
