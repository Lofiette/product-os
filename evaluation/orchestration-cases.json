{
  "schema_version": "4.0-alpha8",
  "cases": [
    {"id":"registry-count","expect":"exactly 10 worker archetypes"},
    {"id":"registry-unique","expect":"unique archetype identifiers"},
    {"id":"role-lens-integrity","expect":"all role lenses exist"},
    {"id":"skill-integrity","expect":"all recommended skills exist"},
    {"id":"output-field-integrity","expect":"all output fields are canonical"},
    {"id":"read-heavy-default","expect":"read-heavy workers default read-only"},
    {"id":"writer-isolation","expect":"writable workers default to worktrees"},
    {"id":"worker-pack-count","expect":"10 custom agent TOML files"},
    {"id":"worker-pack-unique","expect":"TOML names are unique"},
    {"id":"nested-spawn-ban","expect":"worker instructions forbid nested subagents"},
    {"id":"thread-budget","expect":"recommended max_threads is bounded"},
    {"id":"depth-budget","expect":"recommended max_depth is one"},
    {"id":"runtime-budget","expect":"recommended job runtime exists"},
    {"id":"run-schema","expect":"orchestration run schema exists"},
    {"id":"contract-schema","expect":"worker contract schema exists"},
    {"id":"result-schema","expect":"worker result schema exists"},
    {"id":"worktree-schema","expect":"worktree record schema exists"},
    {"id":"quorum-modes","expect":"all_required, all, and n_of_m supported"},
    {"id":"partial-not-success","expect":"partial is not successful quorum evidence"},
    {"id":"unique-archetype-binding","expect":"duplicate archetypes rejected per run"},
    {"id":"structured-result","expect":"explicit structured result submission exists"},
    {"id":"manual-fallback","expect":"approved contracts can receive manual structured results"},
    {"id":"cooperative-cancel","expect":"cancellation states host action is required"},
    {"id":"timeout-reconcile","expect":"worker timeout reconciliation exists"},
    {"id":"checkpoint-bundle","expect":"orchestration state participates in checkpoints"},
    {"id":"compaction-readonly","expect":"managed read-only workers may reconcile across compaction"},
    {"id":"compaction-writer-block","expect":"active writers block compaction"},
    {"id":"dirty-base-guard","expect":"dirty main repo blocks worktree creation by default"},
    {"id":"worktree-scope","expect":"worktree changes are checked against write scope"},
    {"id":"touched-path-proof","expect":"reported touched paths match Git changes"},
    {"id":"no-auto-merge","expect":"worktree integration is review-only"},
    {"id":"receipt-safety","expect":"worker-pack receipt paths are strictly validated"},
    {"id":"uninstall-active-guard","expect":"active runtime blocks uninstall"},
    {"id":"optional-pack","expect":"worker pack is not installed by default"}
  ]
