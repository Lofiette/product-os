  "$id": "cpt://schemas/knowledge-artifact.schema.json",
  "title": "CPT Product Knowledge Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "artifact_type",
    "title",
    "mode",
    "perspective",
    "status",
    "freshness",
    "confidence",
    "scope",
    "owner_role",
    "sharing",
    "data_classification",
    "source_revision",
    "review_triggers",
    "dependencies",
    "claims",
    "unknowns",
    "size_guidance",
    "content",
    "created_at",
    "updated_at"
