        "target",
        "delta",
        "planned",
        "mixed"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "needs_review",
        "stale",
        "deprecated"
      ]
    },
    "freshness": {
      "enum": [
        "current",
        "needs_review",
        "stale"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
