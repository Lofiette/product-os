{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpt://schemas/knowledge-index.schema.json",
  "title": "CPT Product Knowledge Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "mode",
    "status",
    "owner_role",
    "source_revision",
    "current_source_revision",
    "artifact_sequence",
    "artifacts",
    "size_policy",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "4.0-alpha6",
        "4.0-alpha7"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "existing",
        "greenfield",
        "redesign"
      ]
    },
    "status": {
      "enum": [
        "active",
        "needs_review",
        "stale",
        "archived"
      ]
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "recorded_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git_commit",
            "git_tree",
            "user_approval",
            "design_version",
            "external_version",
            "timestamp",
            "none"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "current_source_revision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "recorded_at"
          ],
          "properties": {
            "kind": {
              "enum": [
                "git_commit",
                "git_tree",
                "user_approval",
                "design_version",
                "external_version",
                "timestamp",
                "none"
              ]
            },
            "value": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "artifact_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifact_type",
          "title",
          "path",
          "view_path",
          "status",
          "freshness",
          "confidence",
          "perspective",
          "owner_role",
          "sanitization_status",
          "data_classification",
          "source_revision",
          "dependencies",
          "review_triggers",
          "claim_counts",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "artifact_type": {
            "enum": [
              "product_map",
              "area_map",
              "flow_map",
              "decision_record",
              "api_data_contract",
              "context_packet"
            ]
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^\\.cpt/knowledge/"
          },
          "view_path": {
            "type": "string",
            "pattern": "^\\.cpt/knowledge/"
          },
          "status": {
            "enum": [
              "draft",
              "active",
              "needs_review",
              "stale",
              "deprecated"
            ]
          },
          "freshness": {
            "enum": [
              "current",
              "needs_review",
              "stale"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "perspective": {
            "enum": [
              "current",
              "target",
              "delta",
              "planned",
              "mixed"
            ]
          },
          "owner_role": {
            "type": "string"
          },
          "source_revision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value",
              "recorded_at"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "git_commit",
                  "git_tree",
                  "user_approval",
                  "design_version",
                  "external_version",
                  "timestamp",
                  "none"
                ]
              },
              "value": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "relation"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "enum": [
                    "parent",
                    "child",
                    "depends_on",
                    "feeds",
                    "implements",
                    "supersedes",
                    "references"
                  ]
                }
              }
            }
          },
          "review_triggers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "path_globs",
                "events",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path_globs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "claim_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "data_classification": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "sanitization_status": {
            "enum": [
              "not_reviewed",
              "not_required",
              "sanitized",
              "blocked"
            ]
          }
        }
      }
    },
    "size_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "quality_over_line_count",
        "default_profile"
      ],
      "properties": {
        "mode": {
          "const": "soft_targets"
        },
        "quality_over_line_count": {
          "const": true
        },
        "default_profile": {
          "enum": [
            "compact",
            "standard",
            "extended"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
