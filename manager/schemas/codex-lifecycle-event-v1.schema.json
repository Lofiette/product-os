{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.local/schemas/codex-lifecycle-event-v1.schema.json",
  "title": "Product OS Codex Lifecycle Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter",
    "installation_id",
    "transaction_id",
    "project_path_sha256",
    "session_key_sha256",
    "receipt_sha256",
    "journal_hash",
    "startup_observed_at",
    "ended_at",
    "last_event",
    "last_source",
    "last_observed_at",
    "event_hash"
  ],
  "properties": {
    "schema": {"const": "product-os-codex-lifecycle-event-v1"},
    "adapter": {"const": "codex-session-lifecycle"},
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^TX-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "session_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "journal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "startup_observed_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      ]
    },
    "ended_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      ]
    },
    "last_event": {"enum": ["SessionStart", "SessionEnd"]},
    "last_source": {
      "type": ["string", "null"],
      "enum": ["startup", "resume", "clear", "compact", null]
    },
    "last_observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
