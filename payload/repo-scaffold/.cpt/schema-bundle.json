{
  "authorization-lease.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "cpt://schemas/authorization-lease.schema.json",
    "title": "CPT Scoped Authorization Lease",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "id",
      "status",
      "task_id",
      "micro_change_id",
      "read_scope",
      "write_scope",
      "verification_scope",
      "delegation",
      "forbidden_operations",
      "expires",
      "granted_by",
      "rationale",
      "granted_at",
      "updated_at"
    ],
    "properties": {
      "schema_version": {
        "const": "4.0-alpha2"
      },
      "id": {
        "type": "string",
        "pattern": "^LEASE-[A-Z0-9-]+$"
      },
      "status": {
        "enum": [
          "proposed",
          "active",
          "expired",
          "revoked",
          "consumed"
        ]
      },
      "task_id": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^TKT-[0-9]{3,}$"
          }
        ]
      },
      "micro_change_id": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^MC-[0-9]{3,}$"
          }
        ]
      },
      "read_scope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "write_scope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "verification_scope": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "cwd",
            "purpose"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "cwd": {
              "type": "string",
              "minLength": 1
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "delegation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed",
          "max_workers",
          "read_only",
          "allowed_worker_archetypes"
        ],
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "max_workers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          },
          "read_only": {
            "type": "boolean"
          },
          "allowed_worker_archetypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "forbidden_operations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "expires": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_completion",
          "scope_change",
          "manual_revoke",
          "at"
        ],
        "properties": {
          "task_completion": {
            "type": "boolean"
          },
          "scope_change": {
            "type": "boolean"
          },
          "manual_revoke": {
            "type": "boolean"
          },
          "at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          }
        }
      },
      "granted_by": {
        "enum": [
          "user",
          "managed_policy"
        ]
      },
      "rationale": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string"
          }
        ]
      },
      "granted_at": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "format": "date-time"
          }
        ]
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "oneOf": [
      {
        "required": [
          "task_id"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "micro_change_id": {
            "type": "null"
          }
        }
      },
      {
        "required": [
          "micro_change_id"
        ],
        "properties": {
          "micro_change_id": {
            "type": "string"
          },
          "task_id": {
            "type": "null"
          }
        }
      }
    ]
  },
  "checkpoint.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "cpt://schemas/checkpoint.schema.json",
    "title": "CPT Runtime Checkpoint",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "id",
      "source",
      "reason",
      "created_at",
      "runtime_revision",
      "snapshot",
      "unresolved_work",
      "integrity"
    ],
    "properties": {
      "schema_version": {
        "const": "4.0-alpha2"
      },
      "id": {
        "type": "string",
        "pattern": "^CP-[A-Za-z0-9._-]+$"
      },
      "source": {
        "enum": [
          "manual",
          "pre_compact",
          "phase_handoff",
          "pre_recovery",
          "synthetic"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "runtime_revision": {
        "type": "integer",
        "minimum": 0
      },
      "snapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current",
          "task_index",
          "active_task",
          "active_micro_change",
          "active_lease"
        ],
        "properties": {
          "current": {
            "type": "object"
          },
          "task_index": {
            "type": "object"
          },
          "active_task": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "active_micro_change": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "active_lease": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      },
      "unresolved_work": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blockers",
          "unfinished_verification",
          "next_operation",
          "worker_registry"
        ],
        "properties": {
          "blockers": {
            "type": "array"
          },
          "unfinished_verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_operation": {},
          "worker_registry": {
            "type": "array"
          }
        }
      },
      "integrity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current_sha256",
          "task_index_sha256",
          "active_task_sha256",
          "active_micro_change_sha256",
          "active_lease_sha256"
        ],
        "properties": {
          "current_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "task_index_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "active_task_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "active_micro_change_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "active_lease_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          }
        }
      }
    }
  },
  "current.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "cpt://schemas/current.schema.json",
    "title": "CPT Current State",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "runtime_status",
      "current_task",
      "current_micro_change",
      "current_lease",
      "latest_checkpoint",
      "blockers",
      "next_operation",
      "state_revision",
      "updated_at"
    ],
    "properties": {
      "schema_version": {
        "const": "4.0-alpha2"
      },
      "runtime_status": {
        "enum": [
          "ready",
          "active",
          "blocked",
          "recovering",
          "degraded"
        ]
      },
      "current_task": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^TKT-[0-9]{3,}$"
          }
        ]
      },
      "current_micro_change": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^MC-[0-9]{3,}$"
          }
        ]
      },
      "current_lease": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^LEASE-[A-Z0-9-]+$"
          }
        ]
      },
      "latest_checkpoint": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^CP-[A-Za-z0-9._-]+$"
          }
        ]
      },
      "blockers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "summary",
            "severity"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          }
        }
      },
      "next_operation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "summary"
        ],
        "properties": {
          "type": {
            "enum": [
              "await_user_task",
              "intake",
              "bounded_discovery",
              "impact_map",
              "implementation",
              "verification",
              "recovery",
              "blocked",
              "complete"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "state_revision": {
        "type": "integer",
        "minimum": 0
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "allOf": [
      {
        "not": {
          "required": [
            "current_task",
            "current_micro_change"
          ],
          "properties": {
            "current_task": {
              "type": "string"
            },
            "current_micro_change": {
              "type": "string"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "runtime_status": {
              "const": "ready"
            }
          }
        },
        "then": {
          "properties": {
            "current_task": {
              "type": "null"
            },
            "current_micro_change": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "micro-change.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "cpt://schemas/micro-change.schema.json",
    "title": "CPT Micro Change",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "id",
      "title",
      "status",
      "user_intent",
      "authorization_basis",
      "eligibility",
      "target_paths",
      "read_scope",
      "write_scope",
      "verification",
      "escalation_reason",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "schema_version": {
        "const": "4.0-alpha2"
      },
      "id": {
        "type": "string",
        "pattern": "^MC-[0-9]{3,}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": [
          "proposed",
          "active",
          "verifying",
          "done",
          "escalated",
          "cancelled"
        ]
      },
      "user_intent": {
        "type": "string",
        "minLength": 1
      },
      "authorization_basis": {
        "const": "direct_user_request"
      },
      "eligibility": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_scope",
          "reversible",
          "low_risk",
          "no_public_api_change",
          "no_dependency_change",
          "no_data_migration",
          "no_security_privacy_auth_risk",
          "no_broad_external_read",
          "verification_obvious"
        ],
        "properties": {
          "local_scope": {
            "type": "boolean"
          },
          "reversible": {
            "type": "boolean"
          },
          "low_risk": {
            "type": "boolean"
          },
          "no_public_api_change": {
            "type": "boolean"
          },
          "no_dependency_change": {
            "type": "boolean"
          },
          "no_data_migration": {
            "type": "boolean"
          },
          "no_security_privacy_auth_risk": {
            "type": "boolean"
          },
          "no_broad_external_read": {
            "type": "boolean"
          },
          "verification_obvious": {
            "type": "boolean"
          }
        }
      },
      "target_paths": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "read_scope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "write_scope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "verification": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "escalation_reason": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string"
          }
        ]
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "runtime.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "cpt://schemas/runtime.schema.json",
    "title": "CPT Runtime Configuration",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "runtime_id",
      "storage_mode",
      "sharing_mode",
      "paths",
      "policies",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "schema_version": {
        "const": "4.0-alpha2"
      },
      "runtime_id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,63}$"
      },
      "storage_mode": {
        "const": "file_only"
      },
      "sharing_mode": {
        "enum": [
          "local_ignored",
          "team_shared",
          "local_or_team"
        ]
      },
      "paths": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current",
          "task_index",
          "runtime_summary",
          "tasks",
          "micro_changes",
          "leases",
          "checkpoints"
        ],
        "properties": {
          "current": {
            "type": "string",
            "pattern": "^\\.cpt/"
          },
          "task_index": {
            "type": "string",
            "pattern": "^\\.cpt/"
          },
          "runtime_summary": {
            "type": "string",
            "pattern": "^\\.cpt/"
          },
          "tasks": {
            "type": "string",
            "pattern": "^\\.cpt/"
          },
          "micro_changes": {
            "type": "string",
            "pattern": "^\\.cpt/"
          },
          "leases": {
            "type": "string",
            "pattern": "^\\.cpt/"
          },
          "checkpoints": {
            "type": "string",
            "pattern": "^\\.cpt/"
          }
        }
      },
      "policies": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "no_active_task_allowed",
          "optional_tkt_000",
          "micro_change_enabled",
          "lease_required_for_project_writes",
          "checkpoint_before_compaction",
          "runtime_files_may_update_without_separate_approval"
        ],
        "properties": {
          "no_active_task_allowed": {
            "type": "boolean"
          },
          "optional_tkt_000": {
            "type": "boolean"
          },
          "micro_change_enabled": {
            "type": "boolean"
          },
          "lease_required_for_project_writes": {
            "type": "boolean"
          },
          "checkpoint_before_compaction": {
            "type": "boolean"
          },
          "runtime_files_may_update_without_separate_approval": {
            "type": "boolean"
          }
        }
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "task-index.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "cpt://schemas/task-index.schema.json",
    "title": "CPT Task Index",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "tasks",
      "updated_at"
    ],
    "properties": {
      "schema_version": {
        "const": "4.0-alpha2"
      },
      "tasks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "status",
            "file",
            "updated_at"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^TKT-[0-9]{3,}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "proposed",
                "ready",
                "active",
                "blocked",
                "review",
                "done",
                "cancelled"
              ]
            },
            "file": {
              "type": "string",
              "pattern": "^\\.cpt/tasks/TKT-[0-9]{3,}\\.yaml$"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "task.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "cpt://schemas/task.schema.json",
    "title": "CPT Standard Task",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "id",
      "title",
      "status",
      "task_type",
      "complexity",
      "user_intent",
      "objective",
      "scope",
      "acceptance_criteria",
      "product_knowledge",
      "expertise",
      "impact_map",
      "authorization_lease",
      "verification",
      "blockers",
      "next_operation",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "schema_version": {
        "const": "4.0-alpha2"
      },
      "id": {
        "type": "string",
        "pattern": "^TKT-[0-9]{3,}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": [
          "proposed",
          "ready",
          "active",
          "blocked",
          "review",
          "done",
          "cancelled"
        ]
      },
      "task_type": {
        "type": "string",
        "minLength": 1
      },
      "complexity": {
        "enum": [
          "tiny",
          "fast",
          "standard",
          "complex",
          "high_risk"
        ]
      },
      "user_intent": {
        "type": "string",
        "minLength": 1
      },
      "objective": {
        "type": "string",
        "minLength": 1
      },
      "scope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "in",
          "out"
        ],
        "properties": {
          "in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "out": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "acceptance_criteria": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "text",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "open",
                "met",
                "not_met",
                "waived"
              ]
            }
          }
        }
      },
      "product_knowledge": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "expertise": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roles",
          "skills",
          "gates"
        ],
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "impact_map": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "path"
        ],
        "properties": {
          "status": {
            "enum": [
              "not_started",
              "draft",
              "approved",
              "not_required"
            ]
          },
