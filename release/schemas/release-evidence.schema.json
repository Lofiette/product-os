{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "candidate_manifest_digest", "gates"],
  "properties": {
    "schema_version": {"const": "cpt-release-evidence-v1"},
    "version": {"type": "string"},
    "candidate_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolated_codex_adoption": {"$ref": "#/$defs/gate"},
        "platform_matrix": {"$ref": "#/$defs/gate"},
        "live_model_trials": {"$ref": "#/$defs/gate"},
        "rc_mega_audit": {"$ref": "#/$defs/gate"}
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "notes", "review"],
      "properties": {
        "status": {"enum": ["PASS", "PENDING", "BLOCKED"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "recorded_at"],
          "properties": {
            "authority": {"type": "string", "minLength": 1},
            "recorded_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  }
}
