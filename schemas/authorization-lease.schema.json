{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpt://schemas/authorization-lease.schema.json",
  "title": "CPT Scoped Authorization Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "task_id",
    "micro_change_id",
    "read_scope",
    "write_scope",
    "verification_scope",
    "delegation",
    "forbidden_operations",
    "expires",
    "granted_by",
    "rationale",
    "granted_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "4.0-alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^LEASE-[A-Z0-9-]+$"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "expired",
        "revoked",
        "consumed"
      ]
    },
    "task_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^TKT-[0-9]{3,}$"
        }
      ]
    },
    "micro_change_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^MC-[0-9]{3,}$"
        }
      ]
    },
    "read_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "cwd",
          "purpose"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "max_workers",
        "read_only",
        "allowed_worker_archetypes"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "max_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "read_only": {
          "type": "boolean"
        },
        "allowed_worker_archetypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "forbidden_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_completion",
        "scope_change",
        "manual_revoke",
        "at"
      ],
      "properties": {
        "task_completion": {
          "type": "boolean"
        },
        "scope_change": {
          "type": "boolean"
        },
        "manual_revoke": {
          "type": "boolean"
        },
        "at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      }
    },
    "granted_by": {
      "enum": [
        "user",
        "managed_policy"
      ]
    },
    "rationale": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "granted_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "oneOf": [
    {
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "micro_change_id": {
          "type": "null"
        }
      }
    },
    {
      "required": [
        "micro_change_id"
      ],
      "properties": {
        "micro_change_id": {
          "type": "string"
        },
        "task_id": {
          "type": "null"
        }
      }
    }
  ]
}
