{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpt://schemas/micro-change.schema.json",
  "title": "CPT Micro Change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "user_intent",
    "authorization_basis",
    "eligibility",
    "target_paths",
    "read_scope",
    "write_scope",
    "verification",
    "escalation_reason",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "4.0-alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^MC-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "verifying",
        "done",
        "escalated",
        "cancelled"
      ]
    },
    "user_intent": {
      "type": "string",
      "minLength": 1
    },
    "authorization_basis": {
      "const": "direct_user_request"
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_scope",
        "reversible",
        "low_risk",
        "no_public_api_change",
        "no_dependency_change",
        "no_data_migration",
        "no_security_privacy_auth_risk",
        "no_broad_external_read",
        "verification_obvious"
      ],
      "properties": {
        "local_scope": {
          "type": "boolean"
        },
        "reversible": {
          "type": "boolean"
        },
        "low_risk": {
          "type": "boolean"
        },
        "no_public_api_change": {
          "type": "boolean"
        },
        "no_dependency_change": {
          "type": "boolean"
        },
        "no_data_migration": {
          "type": "boolean"
        },
        "no_security_privacy_auth_risk": {
          "type": "boolean"
        },
        "no_broad_external_read": {
          "type": "boolean"
        },
        "verification_obvious": {
          "type": "boolean"
        }
      }
    },
    "target_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "read_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "escalation_reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
