{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpt://schemas/runtime.schema.json",
  "title": "CPT Runtime Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "storage_mode",
    "sharing_mode",
    "paths",
    "policies",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "4.0-alpha1"
    },
    "runtime_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "storage_mode": {
      "const": "file_only"
    },
    "sharing_mode": {
      "enum": [
        "local_ignored",
        "team_shared",
        "local_or_team"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "task_index",
        "runtime_summary",
        "tasks",
        "micro_changes",
        "leases",
        "checkpoints"
      ],
      "properties": {
        "current": {
          "type": "string",
          "pattern": "^\\.cpt/"
        },
        "task_index": {
          "type": "string",
          "pattern": "^\\.cpt/"
        },
        "runtime_summary": {
          "type": "string",
          "pattern": "^\\.cpt/"
        },
        "tasks": {
          "type": "string",
          "pattern": "^\\.cpt/"
        },
        "micro_changes": {
          "type": "string",
          "pattern": "^\\.cpt/"
        },
        "leases": {
          "type": "string",
          "pattern": "^\\.cpt/"
        },
        "checkpoints": {
          "type": "string",
          "pattern": "^\\.cpt/"
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_active_task_allowed",
        "optional_tkt_000",
        "micro_change_enabled",
        "lease_required_for_project_writes",
        "checkpoint_before_compaction",
        "runtime_files_may_update_without_separate_approval"
      ],
      "properties": {
        "no_active_task_allowed": {
          "type": "boolean"
        },
        "optional_tkt_000": {
          "type": "boolean"
        },
        "micro_change_enabled": {
          "type": "boolean"
        },
        "lease_required_for_project_writes": {
          "type": "boolean"
        },
        "checkpoint_before_compaction": {
          "type": "boolean"
        },
        "runtime_files_may_update_without_separate_approval": {
          "type": "boolean"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
