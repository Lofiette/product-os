{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpt://schemas/task-index.schema.json",
  "title": "CPT Task Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tasks",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "4.0-alpha1"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "file",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TKT-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "ready",
              "active",
              "blocked",
              "review",
              "done",
              "cancelled"
            ]
          },
          "file": {
            "type": "string",
            "pattern": "^\\.cpt/tasks/TKT-[0-9]{3,}\\.yaml$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
